    },
    {
      "role": "--mono-sm",
      "size": "var(--text-sm)",
      "lineK": 1.5,
      "weight": 400,
      "family": "var(--font-mono)",
      "letterSpacing": null,
      "extras": {
        "font-variant-numeric": "tabular-nums"
      },
      "use": "Figures that line up, timestamps",
      "massimo": "F − s"
    },
    {
      "role": "--code",
      "size": "calc(1em - 1px)",
      "lineK": "inherit",
      "weight": 400,
