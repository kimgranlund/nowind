      "size": "var(--text-sm)",
      "lineK": 2,
      "weight": 400,
      "family": "var(--font-body)",
      "letterSpacing": null,
      "use": "Dense secondary prose",
      "massimo": "F − s/2 (snapped to sm)"
    },
    {
      "role": "--caption",
      "size": "var(--text-sm)",
      "lineK": 1.5,
      "weight": 400,
      "family": "var(--font-body)",
      "letterSpacing": null,
      "use": "Secondary text, metadata",
      "massimo": "F − s"
    },
    {
      "role": "--footnote",
      "size": "var(--text-xs)",
      "lineK": 1.5,
      "weight": 400,
      "family": "var(--font-body)",
      "letterSpacing": null,
      "use": "Legal lines, footnotes, fine print",
      "massimo": "F − 2s, at least 10px"
    },
    {
      "role": "--title-sm",
      "size": "var(--text-base)",
      "lineK": 1,
      "weight": 450,
      "family": "var(--font-control)",
      "letterSpacing": null,
      "use": "A control's label",
      "massimo": "F"
    },
    {
      "role": "--control-md",
      "size": "var(--text-base)",
      "lineK": 1.5,
      "weight": 450,
      "family": "var(--font-control)",
      "letterSpacing": null,
      "use": "A field's value, an item's text",
      "massimo": "F"
    },
    {
      "role": "--data",
      "size": "var(--text-base)",
      "lineK": 1,
      "weight": 400,
      "family": "var(--font-body)",
      "letterSpacing": null,
      "extras": {
        "font-variant-numeric": "tabular-nums lining-nums"
      },
      "use": "Table cells, figures in rows",
      "massimo": "F"
    },
    {
      "role": "--label",
      "size": "var(--text-sm)",
      "lineK": 1,
      "weight": 450,
      "family": "var(--font-control)",
      "letterSpacing": null,
      "use": "A field's or a stat's name",
      "massimo": "F − s"
    },
    {
      "role": "--kicker",
