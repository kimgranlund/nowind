      "massimo": "host − 1px"
    }
  ],
  "sizeContract": {
    "description": "Which size each kind of text in an example takes. Sizes follow from what an element is, not from where it sits. the examples lint (scripts/templates.py) will classify each element by the 'identify' rule and check its size against this table; a rendered pass will check rows, hierarchy and icon pairing. Every row is decided; 'review' marks elements the classifier cannot place yet.",
    "kinds": [
      {
        "kind": "control",
        "identify": "button, select, a field box (cursor-text), h-control or h-nested, role tab/option/menuitem, segment",
        "size": "text-base",
        "icon": "icon (icon-sm in a nested control)",
        "status": "decided",
        "current": "99 text-base, 86 inherit (inherit resolves to text-base)"
      },
      {
        "kind": "cell",
        "identify": "td",
        "size": "text-base (inherited)",
        "icon": "icon",
        "status": "decided",
        "current": "all text-base since the table change"
      },
      {
        "kind": "navigation",
        "identify": "a list inside nav: breadcrumbs, pagination, link lists",
        "size": "text-base",
        "icon": "icon (a separator caret is icon-sm)",
        "status": "decided",
        "current": "text-base"
      },
      {
        "kind": "header",
        "identify": "th",
        "size": "text-sm font-medium",
        "icon": "icon-sm",
        "status": "decided",
        "current": "text-sm"
      },
      {
        "kind": "field label",
        "identify": "label, legend",
        "size": "text-sm font-medium",
        "icon": "icon-sm",
        "status": "decided",
        "current": "35 text-sm, 9 text-base, 4 inherit"
      },
      {
        "kind": "supporting",
        "identify": "help and error text, timestamps, captions, secondary lines (fg-neutral-11 span or p under a title)",
        "size": "text-sm",
        "icon": "icon-sm",
        "status": "decided",
        "current": "mostly text-sm"
      },
      {
        "kind": "body",
        "identify": "p in a surface (dialog, card, alert, toast, empty state)",
        "size": "text-base, in every surface",
        "icon": "icon",
        "status": "decided",
        "current": "12 text-sm, 5 text-base"
      },
      {
        "kind": "surface title",
        "identify": "h2/h3 heading a surface",
        "size": "text-lg font-semibold in a dialog; text-base font-semibold everywhere else (cards, lists, alerts, toasts)",
        "icon": "icon-lg on a title row",
        "status": "decided",
        "current": "19 text-base, 3 text-lg"
      },
      {
        "kind": "badge",
        "identify": "rounded-full span with text, tag chips, status pills, counts",
        "size": "text-sm font-medium",
        "icon": "icon-sm",
        "status": "decided",
        "current": "39 text-sm, 26 inherit (markers and avatars)"
      },
      {
        "kind": "count",
        "identify": "a small round marker holding a number or initials: size-nested rounded-full (a count or a small avatar)",
        "size": "text-xs font-medium (tabular-nums for a number)",
        "icon": "none",
        "status": "decided",
        "current": "text-xs"
      },
      {
        "kind": "keycap",
        "identify": "kbd",
        "size": "text-sm font-mono",
        "icon": "none",
        "status": "decided",
        "current": "text-sm"
      },
      {
        "kind": "kicker",
        "identify": "uppercase eyebrow over a title",
        "size": "text-xs font-mono uppercase tracking-widest",
        "icon": "none",
        "status": "decided",
        "current": "6 text-xs"
      },
      {
        "kind": "figure",
        "identify": "price or metric",
        "size": "text-3xl font-display font-extrabold tracking-tight tabular-nums",
        "icon": "none",
        "status": "decided",
        "current": "6 text-3xl"
      },
      {
        "kind": "unclassified",
        "identify": "div, span, li or a with no kind above",
        "size": "inherit",
        "icon": "matches its text",
        "status": "review",
        "current": "~250 elements, mostly wrappers that inherit; about 50 set text-sm or text-base and need a kind"
      }
    ],
    "rules": [
      "Side by side in one row, text shares a size, unless one side is a figure, a badge or a keycap, or the row aligns baselines (items-baseline), which is how a row mixes sizes on purpose.",
      "Within a surface: title >= body >= supporting; a dialog title is larger than its buttons.",
      "An icon takes the step of the text beside it: icon with text-base, icon-sm with text-sm, icon-lg on a title row."
    ]
  },
  "alignmentContract": {
    "description": "How text lines up with the text and boxes around it. ?audit=layout measures each rule from the font's own metrics (canvas measureText), so the check holds for any face.",
    "rules": [
      {
        "id": "baseline",
        "rule": "Single-line text side by side in one row shares a baseline, within 1px, whatever its size or face: a row that mixes sizes aligns with items-baseline. A multi-line block beside a value, and text inside a control, stay centred.",
        "status": "decided"
      },
      {
        "id": "centering",
        "rule": "A label sits optically centred in its control's padding box: the reset trims a control's label to its cap height and alphabetic baseline (text-box), so items-center centres the letters, not the line box. Within 1px.",
        "status": "decided"
      },
      {
        "id": "measure",
        "rule": "Running text is no wider than max-w-text, 68ch of its own font.",
        "status": "decided"
      }
    ]
  }
}
