      "massimo": "F + 2s"
    },
    {
      "role": "--quote",
      "size": "var(--text-lg)",
      "lineK": 1.5,
      "weight": 400,
      "family": "var(--font-body)",
      "letterSpacing": null,
      "extras": {
        "font-style": "italic"
      },
      "use": "A pull quote, a testimonial",
      "massimo": "F + 2s"
    },
    {
      "role": "--title",
      "size": "var(--text-lg)",
      "lineK": 1,
      "weight": 590,
      "family": "var(--font-body)",
      "letterSpacing": null,
      "use": "A card's or panel's title",
      "massimo": "F + s"
    },
    {
      "role": "--subtitle",
      "size": "var(--text-base)",
      "lineK": 1,
      "weight": 590,
      "family": "var(--font-body)",
      "letterSpacing": null,
      "use": "A row's title inside a card",
      "massimo": "F + s/2 (snapped to base)"
    },
    {
      "role": "--body-lg",
      "size": "var(--text-lg)",
      "lineK": 1.5,
      "weight": 400,
      "family": "var(--font-body)",
      "letterSpacing": null,
      "use": "Reading-first pages, articles, help",
      "massimo": "F + s"
    },
    {
      "role": "--body-md",
      "size": "var(--text-base)",
      "lineK": 2,
      "weight": 400,
      "family": "var(--font-body)",
      "letterSpacing": null,
      "use": "Running text",
      "massimo": "F"
    },
    {
