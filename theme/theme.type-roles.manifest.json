{
  "file": "theme.type-roles.css",
  "description": "Nowind semantic type roles, after massimo-v4 (packages/ui/src/fonts.ts typeRoles). Each role is a --{role} size that points at a t-shirt size, with Tailwind v4-style companions: --{role}--line-height, --font-weight, --font-family, --letter-spacing, and --font-variant-numeric / --text-transform / --font-style where the role needs them.",
  "source": "massimo-v4 packages/ui/src/fonts.ts (archived; the live kit is maison-repo packages/ui-kit)",
  "depends": [
    "theme.typography.css (--text-*, --kicker-*, --font-*, --tracking-*)"
  ],
  "naming": {
    "pattern": "--{role}, --{role}--{property}",
    "rule": "Roles sit outside --text-* so they never clash with the t-shirt sizes or the --text-* colour tokens. Companion names follow Tailwind v4's --text-{name}--{property}."
  },
  "lineHeight": {
    "formula": "size + k × (size/2 − 3px), written calc(size × (1 + k/2) − 3k px)",
    "k": {
      "0": "figures, keys: set solid",
      "0.5": "display",
      "1": "titles, headings, controls, labels",
      "1.5": "prose, captions, mono",
      "2": "running body text"
    },
    "source": "massimo line(k) = size + k·q, q = size/2 − 3"
  },
  "weights": {
    "400": "body",
    "450": "control labels (Inter variable)",
    "500": "kbd",
    "590": "titles (Inter variable)",
    "700": "headings",
    "800": "display"
  },
  "snapped": [
    "subtitle: Massimo F + s/2 → --text-base",
    "body-sm: Massimo F − s/2 → --text-sm",
    "heading-sm, lead, quote, title, body-lg share --text-lg; weight and line height tell them apart",
    "heading-xl and display share --text-3xl"
  ],
  "notDone": [
    "Massimo's display tracking (16px − size)/25 is approximated by --tracking-tight (-0.01em).",
    "Massimo's text-box trimming, text-wrap balance/pretty, hanging punctuation, opsz and the control face's cv01/ss03 alternates are not tokens; they belong in role classes.",
    "Massimo's kicker is Inter 450, +0.08em with the case feature; Nowind keeps the Affine kicker (mono 500, 0.16em) through --kicker-*."
  ],
  "roles": [
    {
      "role": "--display-lg",
      "size": "var(--text-6xl)",
      "lineK": 0.5,
      "weight": 800,
      "family": "var(--font-heading)",
      "letterSpacing": "var(--tracking-tight)",
      "use": "A landing page's hero",
      "massimo": "40/14·F → 100/14·F, fluid"
    },
    {
      "role": "--display-md",
      "size": "var(--text-5xl)",
      "lineK": 0.5,
      "weight": 800,
      "family": "var(--font-heading)",
      "letterSpacing": "var(--tracking-tight)",
      "use": "A section's lead on a landing page",
      "massimo": "32/14·F → 72/14·F, fluid"
    },
    {
      "role": "--display-sm",
      "size": "var(--text-4xl)",
      "lineK": 0.5,
      "weight": 800,
      "family": "var(--font-heading)",
      "letterSpacing": "var(--tracking-tight)",
      "use": "An article's or content page's one big title",
      "massimo": "2F → 52/14·F, fluid"
    },
    {
      "role": "--display",
      "size": "var(--text-3xl)",
      "lineK": 0.5,
      "weight": 800,
      "family": "var(--font-heading)",
      "letterSpacing": "var(--tracking-tight)",
      "use": "A page's or dashboard's one big title",
      "massimo": "F + 8s"
    },
    {
      "role": "--heading-xl",
      "size": "var(--text-3xl)",
      "lineK": 1,
      "weight": 700,
      "family": "var(--font-heading)",
      "letterSpacing": "var(--tracking-tight)",
      "use": "An admin or app page's title",
      "massimo": "24/14·F → 32/14·F, fluid"
    },
    {
      "role": "--heading-lg",
      "size": "var(--text-2xl)",
      "lineK": 1,
      "weight": 700,
      "family": "var(--font-heading)",
      "letterSpacing": "var(--tracking-tight)",
      "use": "A page's title in product UI",
      "massimo": "F + 4s → F + 5s"
    },
    {
      "role": "--heading-md",
      "size": "var(--text-xl)",
      "lineK": 1,
      "weight": 700,
      "family": "var(--font-heading)",
      "letterSpacing": "var(--tracking-tight)",
      "use": "A section's heading",
      "massimo": "F + 3s → F + 4s"
    },
    {
      "role": "--heading-sm",
      "size": "var(--text-lg)",
      "lineK": 1,
      "weight": 590,
      "family": "var(--font-body)",
      "letterSpacing": null,
      "use": "A group's heading",
      "massimo": "F + 2s"
    },
    {
      "role": "--figure",
