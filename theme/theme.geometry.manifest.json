{
  "file": "theme.geometry.css",
  "description": "Nowind geometry: every length derives from one input, --F, after Affine UI. At the root --F is the fluid body size (--text-base, 14px at a 360px viewport to 18px at 1240px), so controls, radii, icons and shadows grow with the type. A .scope sets --F to its own font size (1em), so a part of the page can be pinned or resized.",
  "source": "affine-ui tokens/control, tokens/levels, tokens/tiers, tokens/radius",
  "scopes": {
    "selector": ":root, .scope, .tier-product, .tier-content, .tier-brand",
    "rule": "--F is declared twice: :root { --F: var(--text-base) } follows the fluid type scale; .scope { --F: 1em } follows the scope's font-size. Everything derived is declared on :root and on every .scope, so it recomputes in both. --F is registered with @property as a <length>, so it resolves to px."
  },
  "inputs": [
    {
      "token": "--F",
      "value": ":root: var(--text-base); .scope: 1em",
      "use": "The base size. At the root it follows --text-base, so geometry grows with the viewport; in a .scope it is that scope's font size."
    },
    {
      "token": "--slot-slope",
      "value": "2",
      "use": "slot = slope × F + offset."
    },
    {
      "token": "--slot-offset",
      "value": "-8px",
      "use": "See --slot-slope."
    },
    {
      "token": "--border-width",
      "value": "1px",
      "use": "Control border; the inset is the margin minus this."
    },
    {
      "token": "--mg",
      "value": "1",
      "use": "Margin multiplier."
    },
    {
      "token": "--margin-offset",
      "value": "-1px",
      "use": "margin = mg × (slot − F + offset)."
    },
    {
      "token": "--gutter-factor",
      "value": "1",
      "use": "× margin."
    },
    {
      "token": "--row-gap-factor",
      "value": "2",
      "use": "× margin: gap between controls side by side."
    },
    {
      "token": "--row-gap-floor",
      "value": "4px",
      "use": "Side-by-side controls never sit closer than this."
    },
    {
      "token": "--field-gap-factor",
      "value": "1",
      "use": "× margin: label to control, control to help."
    },
    {
      "token": "--group-gap-factor",
      "value": "0.5",
      "use": "× control height: between fields."
    },
    {
      "token": "--surface-factor",
      "value": "1",
      "use": "× slot: card padding and the gap between groups in it."
    },
    {
      "token": "--dialog-factor",
      "value": "1",
      "use": "× control height: dialog padding."
    },
    {
      "token": "--region-factor",
      "value": "1",
      "use": "× slot: sidebar padding."
    },
    {
      "token": "--page-factor",
      "value": "1",
      "use": "× control height: page margin and the gap between surfaces."
    },
    {
      "token": "--tier",
      "value": "1",
      "use": "Multiplies section gap, page margin and display text. Product 1; Affine uses 1.5 for content and 2 for brand."
    },
    {
      "token": "--radius-slope",
      "value": "1",
      "use": "radius = slope × F + offset."
    },
    {
      "token": "--radius-offset",
      "value": "-6px",
      "use": "See --radius-slope."
    },
    {
      "token": "--corner-factor",
      "value": "1",
      "use": "× margin added per level out."
    },
    {
      "token": "--container-max",
      "value": "1280px",
      "use": "Widest the .container class gets."
    },
    {
      "token": "--max-w-text",
      "value": "68ch",
      "use": "Reading measure for .max-w-text."
    },
    {
      "token": "--max-w-form",
      "value": "32rem",
      "use": "Form width for .max-w-form."
    },
    {
      "token": "--icon-md-blend",
      "value": "0.5",
      "use": "How far the md glyph sits from F toward the slot."
    },
    {
      "token": "--q-slope",
      "value": "0.75",
      "use": "q = slope × F + offset (Massimo's unit for shadows)."
    },
    {
      "token": "--q-offset",
      "value": "-6.75px",
      "use": "See --q-slope."
    },
    {
      "token": "--tier-content",
      "value": "1.5",
      "use": "--tier inside .tier-content: page, section, surface and dialog spacing grow 1.5×."
    },
    {
      "token": "--tier-brand",
      "value": "2",
      "use": "--tier inside .tier-brand."
    },
    {
      "token": "--tier-content-text",
      "value": "2px",
      "use": ".tier-content sets its font size this much above its parent's."
    },
    {
      "token": "--tier-brand-text",
      "value": "4px",
      "use": ".tier-brand sets its font size this much above its parent's."
    },
    {
      "token": "--grid-columns",
      "value": "12",
      "use": "Columns in the page grid."
    },
    {
      "token": "--grid-gutter-factor",
      "value": "2",
      "use": "× margin: the gutter between two columns."
    },
    {
      "token": "--shell-sidebar-slope",
      "value": "16",
      "use": "sidebar width = slope × F + offset."
    },
    {
      "token": "--shell-sidebar-offset",
      "value": "16px",
      "use": "See --shell-sidebar-slope."
    },
    {
      "token": "--shell-measure-factor",
      "value": "44",
      "use": "× F: a column of text about 44 characters wide."
    },
    {
      "token": "--mark-corner",
      "value": "0.25",
      "use": "Checkbox corner as a share of the mark."
    },
    {
      "token": "--range-thumb-share",
      "value": "0.5",
      "use": "A slider's handle is this share of the mark."
    },
    {
      "token": "--range-track-cut",
      "value": "8px",
      "use": "A slider's track is the mark minus this, over the parts below."
    },
    {
      "token": "--range-track-parts",
      "value": "3",
      "use": "See --range-track-cut."
    }
  ],
  "control": [
    {
      "token": "--slot",
      "formula": "2F − 8",
      "at14": "20px",
      "at16": "24px",
      "use": "Line box of a control; body line height."
    },
    {
      "token": "--q",
      "formula": "0.75F − 6.75",
      "at14": "3.75px",
      "at16": "5.25px",
      "use": "Massimo's length unit; every shadow layer is a multiple of it, so shadows scale with the scope's font size."
    },
    {
      "token": "--margin",
      "formula": "slot − F − 1, at least the border",
      "at14": "5px",
      "at16": "7px",
      "use": "Outer edge to slot."
    },
    {
      "token": "--inset",
      "formula": "margin − border",
      "at14": "4px",
      "at16": "6px",
      "use": "Padding inside the border."
    },
    {
      "token": "--gutter",
      "formula": "margin",
      "at14": "5px",
      "at16": "7px",
      "use": "Between a control's parts."
    },
    {
      "token": "--row-gap",
      "formula": "2 × margin, at least 4px",
      "at14": "10px",
      "at16": "14px",
      "use": "Between controls side by side."
    },
    {
      "token": "--control-height",
      "formula": "slot + 2 × margin",
      "at14": "30px",
      "at16": "38px",
      "use": "Height of a button or input."
    },
    {
      "token": "--text-edge",
      "formula": "2 × margin",
      "at14": "10px",
      "at16": "14px",
      "use": "Outer edge to text where no icon sits."
    },
    {
      "token": "--nested-height",
      "formula": "slot",
      "at16": "24px",
      "use": "Height of a small control and of a control nested in another."
    },
    {
      "token": "--control-padding",
      "formula": "text edge − border (2M − B)",
      "at16": "13px",
      "use": "Inline padding of a control on a side with text; class px-control."
    },
    {
      "token": "--control-icon-padding",
      "formula": "control padding − margin (M − B)",
      "at16": "6px",
      "use": "Inline padding on a side that holds an icon, so the icon's box sits one margin from the outer edge."
    },
    {
      "token": "--nested-padding",
      "formula": "margin",
      "at16": "7px",
      "use": "Inline padding of a small control; class px-nested."
    },
    {
      "token": "--nested-icon-padding",
      "formula": "nested padding − margin, at least 0",
      "at16": "0px",
      "use": "Inline padding of a small control on an icon side."
    }
  ],
  "levels": [
    {
      "token": "--field-gap",
      "formula": "margin",
      "use": "Label to control, control to help."
    },
    {
      "token": "--group-gap",
      "formula": "0.5 × control height",
      "use": "Between fields."
    },
    {
      "token": "--surface-padding",
      "formula": "tier-inner × slot",
      "use": "Card padding."
    },
    {
      "token": "--section-gap",
      "formula": "tier × slot",
      "use": "Above a heading that starts a section."
    },
    {
      "token": "--dialog-padding",
      "formula": "tier-inner × control height",
      "use": "Dialog padding."
    },
    {
      "token": "--region-padding",
      "formula": "slot",
      "use": "Sidebar padding."
    },
    {
      "token": "--page-margin",
      "formula": "tier × control height",
      "use": "Content-area margin and the gap between surfaces."
    }
  ],
  "helpers": [
    "--tier-inner",
    "--surface-base",
    "--dialog-base"
  ],
  "notes": [
    "The fluid --space-* scale lives in theme.space.css (generated by scripts/utopia.mjs)."
  ],
  "radius": [
    {
      "token": "--radius-control",
      "formula": "F − 6, capped at a pill",
      "use": "A control's corner; class rounded."
    },
    {
      "token": "--radius-nested",
      "formula": "control − margin",
      "use": "One level in; class rounded-sm."
    },
    {
      "token": "--radius-surface",
      "formula": "control + margin",
      "use": "A card; class rounded-lg."
    },
    {
      "token": "--radius-dialog",
      "formula": "control + 2 × margin",
      "use": "A dialog; class rounded-xl."
    }
  ],
  "container": [
    {
      "token": "--container-padding",
      "formula": "page-margin",
      "use": "Inline padding of .container."
    }
  ],
  "breakpoints": {
    "tokens": {
      "--breakpoint-sm": "640px",
      "--breakpoint-md": "768px",
      "--breakpoint-lg": "1024px",
      "--breakpoint-xl": "1280px",
      "--breakpoint-2xl": "1536px"
    },
    "rule": "Tailwind v4 names and values. CSS can't read a custom property inside @media, so scripts/utilities.mjs reads these values when it writes the sm: … 2xl: variants."
  },
  "icons": {
    "rule": "After Affine UI's <ui-icon>: an S-square box with the glyph centred. Phosphor's weights follow the size: ph-bold at sm, ph (regular) at md, ph-light at lg.",
    "tokens": [
      {
        "token": "--icon-box",
        "formula": "slot",
        "at16": "24px",
        "use": "The icon's box; class icon."
      },
      {
        "token": "--icon-sm",
        "formula": "F",
        "at16": "16px",
        "use": "Small glyph; class icon-sm."
      },
      {
        "token": "--icon-md",
        "formula": "F + blend × (slot − F)",
        "at16": "20px",
        "use": "Default glyph; class icon."
      },
      {
        "token": "--icon-lg",
        "formula": "slot",
        "at16": "24px",
        "use": "Large glyph; class icon-lg."
      }
    ]
  },
  "fluid": {
    "at360": {
      "F": "14px",
      "slot": "20px",
      "margin": "5px",
      "controlHeight": "30px"
    },
    "at800": {
      "F": "16px",
      "slot": "24px",
      "margin": "7px",
      "controlHeight": "38px"
    },
    "at1240": {
      "F": "18px",
      "slot": "28px",
      "margin": "9px",
      "controlHeight": "46px"
    }
  },
  "tiers": {
    "rule": "After Affine's space tiers. .tier-product (1×, the default), .tier-content (font +2px, spacing 1.5×) and .tier-brand (font +4px, spacing 2×) are scopes: --F and everything derived from it recompute inside them. --tier multiplies --page-margin and --section-gap; --tier-inner (half strength, at least 1) multiplies --surface-padding and --dialog-padding.",
    "selectors": ".scope, .tier-product, .tier-content, .tier-brand share the scope declarations in theme.geometry.css, theme.space.css and theme.shadows.css."
  },
  "grid": {
    "source": "affine-ui tokens/grid",
    "tokens": [
      {
        "token": "--grid-gutter",
        "formula": "2M",
        "at16": "14px",
        "use": "Between two columns; class gap-grid."
      },
      {
        "token": "--grid-inset",
        "formula": "gutter / 2 (M)",
        "at16": "7px",
        "use": "A placed element pads itself by this, so two neighbours make one gutter; class p-grid-inset."
      },
      {
        "token": "--grid-margin-regular",
        "formula": "slot",
        "at16": "24px",
        "use": "Page edge padding where there is room; class px-grid. No tier multiplies it."
      },
      {
        "token": "--grid-margin-compact",
        "formula": "max(gutter, slot / 2)",
        "at16": "14px",
        "use": "Page edge padding on narrow screens; class px-grid-compact."
      }
    ]
  },
  "shell": {
    "source": "affine-ui tokens/shell",
    "tokens": [
      {
        "token": "--shell-sidebar-width",
        "formula": "16F + 16",
        "at16": "272px",
        "use": "The app's sidebar; class w-sidebar."
      },
      {
        "token": "--shell-rail-width",
        "formula": "H + 2S",
        "at16": "86px",
        "use": "The collapsed sidebar rail; class w-rail."
      },
      {
        "token": "--shell-header-height",
        "formula": "H + S",
        "at16": "62px",
        "use": "The app header; class h-header."
      },
      {
        "token": "--shell-measure",
        "formula": "44F",
        "at16": "704px",
        "use": "A column of text; class max-w-measure."
      },
      {
        "token": "--shell-dock-width",
        "formula": "sidebar + measure + 2 × page margin",
        "at16": "1052px",
        "use": "The page width at which the sidebar docks beside the content."
      }
    ]
  },
  "marks": {
    "source": "affine-ui tokens/small",
    "rule": "A mark (checkbox, radio, switch, slider) is an icon's drawing size: sm F, md between F and the slot (the default), lg the slot. The reset draws native inputs with these; classes mark-sm and mark-lg pick another size.",
    "tokens": [
      {
        "token": "--mark-sm / --mark-md / --mark-lg",
        "formula": "the icon sizes",
        "at16": "16 / 20 / 24px"
      },
      {
        "token": "--switch-width-md",
        "formula": "2 × mark − 4B",
        "at16": "36px"
      },
      {
        "token": "--switch-thumb-md",
        "formula": "mark − 4B",
        "at16": "16px"
      },
      {
        "token": "--range-thumb-md",
        "formula": "share × mark",
        "at16": "10px"
      },
      {
        "token": "--range-track-md",
        "formula": "(mark − cut) / parts, at least B",
        "at16": "4px"
      }
    ]
  }
}
